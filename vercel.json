{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/asset-manifest.json",
      "dest": "/asset-manifest.json"
    },
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/logo192.svg",
      "dest": "/logo192.svg"
    },
    {
      "src": "/logo512.svg",
      "dest": "/logo512.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}